# Settings for the live server. Copy to /etc/annur/annur.env and edit (see DEPLOYMENT.md).
# This file holds a secret: it must be readable only by root and the annur service user (chmod 640).

ANNUR_ENV=production

# A long random value, different for every installation. Create one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=PASTE-THE-GENERATED-VALUE-HERE

# The address people type in the browser, without https://. Several can be separated by commas.
ANNUR_HOSTS=erp.example.com

# Database, uploaded files and backups. Outside the code folder so an update never touches them.
ANNUR_DATA_DIR=/var/lib/annur

# Optional: keep backups somewhere else (a second disk or a mounted share)
# ANNUR_BACKUP_DIR=/var/backups/annur

# Optional: how long browsers remember to use HTTPS only. Default is one day; once the site works
# over HTTPS raise it to one year (31536000).
# ANNUR_HSTS_SECONDS=31536000
