# Every night at 02:30 server time (set the server to Asia/Kuala_Lumpur, see DEPLOYMENT.md).
# Persistent: if the server was off at 02:30 the backup runs when it starts again.
[Unit]
Description=Nightly backup of the An Nur ERP

[Timer]
OnCalendar=*-*-* 02:30:00
Persistent=true

[Install]
WantedBy=timers.target
